r1 [label=<<table border="0" cellspacing="0" cellpadding="1"><tr><td align="left"><b><font point-size="13">rank 1</font></b>   node 0, local GPU 1</td></tr><tr><td align="left"><font point-size="9" color="#444444">tp=1 dp=0 pp=0: 1+2*0+4*0 = 1</font></td></tr><tr><td align="left"><font color="#2E7D32">TP 0 {0,1}</font>  <font color="#B8860B">DP 1 {1,3}</font></td></tr><tr><td align="left">PP 1 {1,5,9,13}  <font color="#2E86AB"><b>MP 0</b></font></td></tr><tr><td align="left"><font color="#B71C1C"><b>EMB 1 {1,13}</b></font></td></tr></table>>, fillcolor="#E8F4FD", penwidth=3, color="#B71C1C"];
}
